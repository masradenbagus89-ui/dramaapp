{
  "name": "lintasai",
  "version": "3.0.0",
  "description": "AI workflow kit untuk Claude Code & Kimi Code CLI dengan tier model + cross-repo automation (Windows-first)",
  "bin": {
    "lintasai": "bin/lintasai.js"
  },
  "files": [
    "bin/",
    "setup-pola-b.mjs",
    "kit.mjs",
    "update-kit.mjs",
    "uninstall.mjs",
    "engine/",
    "templates/",
    "rules/",
    "skills/",
    "docs/",
    "!docs/plans",
    "!docs/plans/**",
    "docs/plans/POLA_REPO_AMAN.md",
    "!docs/BUKU_PELAJARAN.md",
    "!docs/AUDIT_HISTORY.md",
    "!docs/PETA_SUMBER_KEBENARAN.md",
    "!docs/migration-state.md",
    "!docs/env-check.md",
    "!docs/install-secret-hook.md",
    "!docs/unicode-safety-check.md",
    "!docs/env-keys-check.md",
    "!docs/serap-skill",
    "!docs/serap-skill/**",
    "!docs/arsip",
    "!docs/arsip/**",
    "!docs/decisions/ADR-003-migrasi-bertahap-powershell-ke-node.md",
    "!docs/decisions/ADR-004-konsolidasi-besar-ke-node.md",
    "!docs/decisions/ADR-005-jalur-tim-100-persen-node.md",
    "!docs/decisions/ADR-006-sistem-feedback-pembelajaran-lintas-client.md",
    "!docs/decisions/ADR-008-hook-penegak-checklist-penyelesaian.md",
    "!docs/decisions/ADR-009-perkuat-jangan-kurung.md",
    "!docs/decisions/ADR-010-kebijakan-industri-teregulasi.md",
    "!docs/decisions/ADR-011-peta-aktivitas-git-on-demand.md",
    "!docs/decisions/ADR-012-blok-belajar-junior-profesi.md",
    "!docs/decisions/ADR-013-format-rencana-plan-mode.md",
    "!docs/decisions/ADR-014-palang-fakta.md",
    "!docs/decisions/ADR-015-native-kimi-code.md",
    "!docs/decisions/ADR-018-profil-tim-kit-kondisi-tetap.md",
    "!docs/decisions/ADR-019-hemat-token-feedback-capture-dan-anggaran-gabungan.md",
    "!docs/decisions/ADR-022-petunjuk-rak-dan-palang-rak.md",
    "!docs/decisions/ADR-023-cabut-ritual-8-divisi.md",
    "!docs/decisions/ADR-024-inti-ramping-7-hal.md",
    "!docs/decisions/ADR-025-term-first-istilah-programming.md",
    "!docs/decisions/ADR-026-hapus-blok-belajar.md",
    "!docs/decisions/ADR-028-kenapa-singkat-tiap-langkah.md",
    "!docs/decisions/ADR-029-perampingan-pasca-3.0.0.md",
    "!CHANGELOG_ARCHIVE.md",
    "tests/",
    "!tests/*.test.mjs",
    "AUDIT_POST_SETUP_PROMPT_v1.md",
    "CHANGELOG.md",
    "CLAUDE_universal_v1.md",
    "CONTRIBUTING.md",
    "JALANKAN_KIT.md",
    "KIMI_CODE_SETUP.md",
    "LINTASAI_WORKFLOWS_v1.md",
    "PETA.md",
    "POST_SETUP_CHECKLIST_PROMPT_v1.md",
    "PROJECT_LIFECYCLE_PROMPT_v1.md",
    "README.md",
    "SECURITY.md",
    "SPLIT_REPO_MIGRATION_PROMPT_v1.md",
    "UPDATE_KIT_PROMPT_v1.md",
    "UPGRADING.md",
    "*.template",
    "AGENTS.md.template",
    ".github/workflows/validate.yml",
    "LICENSE",
    ".gitignore"
  ],
  "scripts": {
    "test": "node tests/run-node-tests.mjs",
    "test:coverage": "node tests/run-node-tests.mjs --experimental-test-coverage",
    "test:watch": "node tests/run-node-tests.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preflight": "node tests/preflight.mjs",
    "preflight:strict": "node tests/preflight.mjs --strict"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0"
  },
  "keywords": [
    "ai",
    "claude-code",
    "kit",
    "workflow"
  ],
  "author": "ojokesusu",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojokesusu/lintasAI.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
