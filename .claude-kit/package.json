{
  "name": "lintasai",
  "version": "1.57.1",
  "description": "AI workflow kit untuk Claude Code dengan tier model + cross-repo automation (Windows-first)",
  "bin": {
    "lintasai": "bin/lintasai.js"
  },
  "files": [
    "bin/",
    "*.ps1",
    "*.psm1",
    "lib/",
    "templates/",
    "docs/",
    "tests/",
    "AUDIT_POST_SETUP_PROMPT_v1.md",
    "CHANGELOG.md",
    "CLAUDE_universal_v1.md",
    "CONTRIBUTING.md",
    "JALANKAN_KIT.md",
    "LINTASAI_WORKFLOWS_v1.md",
    "MULAI_DI_SINI.md",
    "POST_SETUP_CHECKLIST_PROMPT_v1.md",
    "PROJECT_LIFECYCLE_PROMPT_v1.md",
    "README.md",
    "SECURITY.md",
    "SPLIT_REPO_MIGRATION_PROMPT_v1.md",
    "TEAM_ROLLOUT_GUIDE_v1.md",
    "UPDATE_KIT_PROMPT_v1.md",
    "*.template",
    "AGENTS.md.template",
    ".github/",
    "LICENSE",
    ".gitignore"
  ],
  "scripts": {
    "test": "echo \"Pester tests run via ./tests/Run-Tests.ps1\" && exit 0"
  },
  "keywords": [
    "ai",
    "claude-code",
    "powershell",
    "kit",
    "workflow"
  ],
  "author": "ojokesusu",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "os": [
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ojokesusu/lintasAI.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  }
}
