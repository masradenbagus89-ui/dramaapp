# =====================================================================
# Contoh env vars DramaApp. Salin ke .env.local (lokal) atau set di Vercel.
# (.env.local TIDAK ikut ke git.)
# =====================================================================

# --- Database: Supabase (WAJIB di produksi) --------------------------
# Ada di Supabase Dashboard -> Project Settings -> API.
# Tanpa kedua var ini, app otomatis fallback ke file JSON di data/ (mode dev).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — RAHASIA, server-side only. JANGAN diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Auth admin ------------------------------------------------------
ADMIN_PASSWORD=ganti-password-admin
AUTH_SECRET=string-acak-panjang-minimal-32-karakter

# --- Pengiriman video (tunnel dari PC backup) ------------------------
NEXT_PUBLIC_VIDEO_BASE_URL=https://contoh-tunnel.trycloudflare.com
HARDLINK_AGENT_SECRET=rahasia-agen-hardlink

# --- Top-up koin: Midtrans (opsional) --------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Izinkan top-up "demo" tanpa uang (uji coba). Kosongkan di produksi.
ENABLE_DEMO_TOPUP=

# --- Iklan otomatis (auto ads) — OPSIONAL ----------------------------
# Banner pasif di /beranda & /profile buat passive income. KALAU KOSONG:
# slot otomatis menampilkan iklan manual dari /admin#iklan (atau promo
# DramaKu), jadi tidak pernah kosong. Beda dari modal "Nonton iklan"
# (rewarded/koin) yang tetap dikelola manual.
#
# Pilihan A — Google AdSense (kalau situs disetujui Google):
NEXT_PUBLIC_ADSENSE_CLIENT=        # mis. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT=          # id unit iklan dari dashboard AdSense
# (AdSense juga butuh file public/ads.txt: "google.com, pub-XXXX, DIRECT, f08c47fec0942fa0")
#
# Pilihan B — network lain (Adsterra/Monetag) kalau AdSense ditolak.
# Tempel kode banner mereka apa adanya (boleh multi-baris). Kalau diisi,
# ini MENIMPA AdSense.
NEXT_PUBLIC_AD_BANNER_HTML=

# --- Generate data drama dari IMDb (via OMDb API) ----------------------
# Daftar gratis di https://www.omdbapi.com/apikey.aspx, lalu tempel key di sini.
# Hanya dipakai server-side, jadi TIDAK perlu NEXT_PUBLIC_.
OMDB_API_KEY=

# --- Video dari dashboard upload (playly-dashboard) — OPSIONAL ---------
# Jalur: browser -> /api/videos (server kita) -> API dashboard -> Supabase.
# Panduan lengkap: docs/sambungan-dashboard-webmovie.md
#
# Alamat endpoint daftar video di dashboard. KALAU KOSONG: bagian
# "Video terbaru" di /discover tidak muncul sama sekali (disengaja, bukan bug),
# dan /api/videos membalas 503.
DASHBOARD_API_URL=
# Kunci API dashboard (kalau dashboard memintanya). Dikirim sebagai
# "Authorization: Bearer <kunci>" dari SERVER, jadi tidak pernah sampai ke browser.
DASHBOARD_API_KEY=
# Pengetat opsional: domain berkas video yang boleh diputar, dipisah koma.
# KOSONG = semua alamat https diterima. Contoh: xxxx.supabase.co
DASHBOARD_VIDEO_HOSTS=

# --- Video dari API pihak lain (player milik mereka / embed) — OPSIONAL -
# Jalur: browser -> /api/external-videos (server kita) -> API penyedia.
# Panduan lengkap: docs/video-eksternal.md
#
# Alamat endpoint daftar video milik penyedia. KOSONG = /api/external-videos
# membalas 503 dan halaman /video-eksternal menampilkan pesan setelan belum diisi.
EXTERNAL_VIDEO_API_URL=
# Kunci API penyedia (kosongkan kalau API-nya terbuka).
EXTERNAL_VIDEO_API_KEY=
# Cara kunci dikirim — isi SALAH SATU saja, atau kosongkan dua-duanya:
#   dua-duanya kosong -> header "Authorization: Bearer <kunci>"
#   header khusus     -> tulis nama headernya, mis. X-API-Key
EXTERNAL_VIDEO_API_KEY_HEADER=
#   lewat query       -> tulis nama parameternya, mis. api_key
EXTERNAL_VIDEO_API_KEY_PARAM=
# PAGAR KEAMANAN (WAJIB kalau jalur ini dipakai): domain player yang boleh
# tampil di dalam iframe, dipisah koma. Subdomain ikut lolos.
# ⚠️ KOSONG = SEMUA video ditolak (sengaja "tolak dulu semua"), bukan sebaliknya.
EXTERNAL_VIDEO_EMBED_HOSTS=

# Catatan: GITHUB_TOKEN / GITHUB_REPO_* TIDAK lagi diperlukan setelah migrasi
# ke Supabase (dulu dipakai untuk menyimpan drama via commit GitHub).
