# =====================================================================
# Contoh env vars DramaApp. Salin ke .env.local (lokal) atau set di Vercel.
# (.env.local TIDAK ikut ke git.)
# =====================================================================

# --- Database: Supabase (WAJIB di produksi) --------------------------
# Ada di Supabase Dashboard -> Project Settings -> API.
# Tanpa kedua var ini, app otomatis fallback ke file JSON di data/ (mode dev).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role key — RAHASIA, server-side only. JANGAN diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Auth admin ------------------------------------------------------
ADMIN_PASSWORD=ganti-password-admin
AUTH_SECRET=string-acak-panjang-minimal-32-karakter

# --- Pengiriman video (tunnel dari PC backup) ------------------------
NEXT_PUBLIC_VIDEO_BASE_URL=https://contoh-tunnel.trycloudflare.com
HARDLINK_AGENT_SECRET=rahasia-agen-hardlink

# --- Top-up koin: Midtrans (opsional) --------------------------------
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
# Izinkan top-up "demo" tanpa uang (uji coba). Kosongkan di produksi.
ENABLE_DEMO_TOPUP=

# --- Iklan otomatis (auto ads) — OPSIONAL ----------------------------
# Banner pasif di /beranda & /profile buat passive income. KALAU KOSONG:
# slot otomatis menampilkan iklan manual dari /admin#iklan (atau promo
# DramaKu), jadi tidak pernah kosong. Beda dari modal "Nonton iklan"
# (rewarded/koin) yang tetap dikelola manual.
#
# Pilihan A — Google AdSense (kalau situs disetujui Google):
NEXT_PUBLIC_ADSENSE_CLIENT=        # mis. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_SLOT=          # id unit iklan dari dashboard AdSense
# (AdSense juga butuh file public/ads.txt: "google.com, pub-XXXX, DIRECT, f08c47fec0942fa0")
#
# Pilihan B — network lain (Adsterra/Monetag) kalau AdSense ditolak.
# Tempel kode banner mereka apa adanya (boleh multi-baris). Kalau diisi,
# ini MENIMPA AdSense.
NEXT_PUBLIC_AD_BANNER_HTML=

# --- Generate data drama dari IMDb (via OMDb API) ----------------------
# Daftar gratis di https://www.omdbapi.com/apikey.aspx, lalu tempel HANYA kuncinya
# (biasanya 8 karakter). Jangan tempel URL lengkap http://www.omdbapi.com/?...
# Hanya dipakai server-side, jadi TIDAK perlu NEXT_PUBLIC_.
OMDB_API_KEY=

# Opsional: banner lebar (hero) dari TMDB. OMDb hanya punya poster tegak.
# Daftar gratis di https://www.themoviedb.org/settings/api — pakai API Key (v3).
# Kalau kosong, hero memakai poster. Hanya server-side, jangan NEXT_PUBLIC_.
TMDB_API_KEY=

# --- Video dari dashboard upload (playly-dashboard) — OPSIONAL ---------
# Jalur: browser -> /api/videos (server kita) -> API dashboard -> Supabase.
# Panduan lengkap: docs/sambungan-dashboard-webmovie.md
#
# Alamat endpoint daftar video di dashboard. KALAU KOSONG: bagian
# "Video terbaru" di /discover tidak muncul sama sekali (disengaja, bukan bug),
# dan /api/videos membalas 503.
DASHBOARD_API_URL=
# Kunci API dashboard (kalau dashboard memintanya). Dikirim dari SERVER,
# jadi tidak pernah sampai ke browser pengunjung.
DASHBOARD_API_KEY=
# Nama header tempat kunci dititipkan. KOSONG = cara umum
# "Authorization: Bearer <kunci>". Isi kalau dashboard memeriksa header lain —
# Playly, misalnya, HANYA membaca "X-Playly-Key" dan mengabaikan Bearer.
# Salah nama header = dashboard membalas 401 walau kuncinya benar.
DASHBOARD_API_KEY_HEADER=
# Pengetat opsional: domain berkas video yang boleh diputar, dipisah koma.
# KOSONG = semua alamat https diterima. Contoh: xxxx.supabase.co
DASHBOARD_VIDEO_HOSTS=

# --- Video dari API pihak lain (player milik mereka / embed) — OPSIONAL -
# Jalur: browser -> /api/external-videos (server kita) -> API penyedia.
# Panduan lengkap: docs/video-eksternal.md
#
# Alamat endpoint daftar video milik penyedia. KOSONG = /api/external-videos
# membalas 503 dan halaman /video-eksternal menampilkan pesan setelan belum diisi.
EXTERNAL_VIDEO_API_URL=
# Kunci API penyedia (kosongkan kalau API-nya terbuka).
EXTERNAL_VIDEO_API_KEY=
# Cara kunci dikirim — isi SALAH SATU saja, atau kosongkan dua-duanya:
#   dua-duanya kosong -> header "Authorization: Bearer <kunci>"
#   header khusus     -> tulis nama headernya, mis. X-API-Key
EXTERNAL_VIDEO_API_KEY_HEADER=
#   lewat query       -> tulis nama parameternya, mis. api_key
EXTERNAL_VIDEO_API_KEY_PARAM=
# PAGAR KEAMANAN (WAJIB kalau jalur ini dipakai): domain player yang boleh
# tampil di dalam iframe, dipisah koma. Subdomain ikut lolos.
# ⚠️ KOSONG = SEMUA video ditolak (sengaja "tolak dulu semua"), bukan sebaliknya.
EXTERNAL_VIDEO_EMBED_HOSTS=

# --- Integrasi PLAYLY (kita = "Mitra" yang memakai video Playly) -------
# Panduan lengkap: docs/playly-integrasi.md
# Alur: browser admin -> /api/admin/playly/* (server kita) -> API Playly.
# Kunci API Playly TIDAK ditaruh di sini — admin memasukkannya lewat halaman
# /admin/settings/playly, lalu disimpan TERENKRIPSI di database.
#
# WAJIB kalau fitur Playly dipakai: kunci pengacak untuk enkripsi kunci API.
# Buat sekali dengan perintah berikut, lalu tempel hasilnya di sini:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KALAU KOSONG: halaman setelan menolak menyimpan kunci Playly (bukan bug).
# ⚠️ JANGAN diganti setelah kunci Playly tersimpan — kunci lama jadi tidak
#    bisa dibuka, dan harus dimasukkan ulang lewat halaman setelan.
PLAYLY_ENCRYPTION_KEY=

# Alamat dasar Playly. KOSONG = pakai bawaan https://playly-dashboard.vercel.app
# Endpoint daftar video otomatis jadi <alamat ini>/api/videos
PLAYLY_API_URL=

# OPSIONAL — jalan pintas menaruh kunci Playly lewat env (mis. saat database
# belum siap). Yang tersimpan di database SELALU menang atas nilai di sini.
#
# KOSONG BUKAN BERARTI MATI: tanpa kunci, daftar video diambil dari katalog
# PUBLIK Playly (/api/catalog) supaya admin tetap bisa memilih video. Kunci
# mitra hanya diperlukan kalau daftarnya mau dibatasi ke video akun tertentu.
# Kunci mitra diterbitkan pengelola Playly, bukan dibuat sendiri.
PLAYLY_API_KEY=

# OPSIONAL — domain player TAMBAHAN yang boleh tampil di dalam <iframe>,
# dipisah koma. Domain resmi playly-dashboard.vercel.app selalu diizinkan;
# isi ini hanya kalau Playly memakai domain lain untuk playernya.
PLAYLY_EMBED_HOSTS=

# OPSIONAL — pola alamat player, dipakai HANYA kalau daftar video dari Playly
# tidak menyertakan embedUrl.
# Bawaan: /id/{id}/embed  ({id} diganti id video) — TERVERIFIKASI 2026-08-25
# dari katalog Playly asli. (Sebelumnya ditebak "/embed/{id}" dan selalu salah,
# sehingga tidak ada satu pun video yang bisa dipasang.)
PLAYLY_EMBED_PATH=

# ⚠️ PENTING — GERBANG DOMAIN DI SISI PLAYLY (tidak ada setelannya di sini).
# Playly hanya mau video-nya disematkan di domain mitra yang SUDAH DIDAFTARKAN
# di sisi mereka. Domain lain menerima halaman "Situs ini belum diizinkan".
# Terverifikasi 2026-08-25: dramaapp.vercel.app SUDAH terdaftar; localhost TIDAK.
# Akibatnya video Playly memang tidak bisa dicoba dari komputer sendiri —
# itu perilaku normal, bukan kerusakan. Domain baru harus didaftarkan lewat
# pengelola Playly.

# Catatan: GITHUB_TOKEN / GITHUB_REPO_* TIDAK lagi diperlukan setelah migrasi
# ke Supabase (dulu dipakai untuk menyimpan drama via commit GitHub).
