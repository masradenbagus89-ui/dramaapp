node_modules/
.next/
out/
build/
# Cache hasil pemeriksaan tipe TypeScript — dibuat ulang otomatis, jangan di-commit.
tsconfig.tsbuildinfo
.env
.env*.local
*.log
.DS_Store

# Rahasia 2FA admin — JANGAN pernah commit (repo publik).
data/twofa.json
# Cookie jar hasil uji curl — berisi token sesi admin yang masih hidup.
cookies.txt
# Recovery code / kode cadangan 2FA akun luar (Vercel, GitHub) = kunci serep akun.
# Tempat simpan yang BENAR: password manager atau di luar folder ini — pola ini cuma jaring
# kalau berkasnya tak sengaja tercecer di sini. Sengaja dibatasi .txt + "codes" jamak supaya
# tidak menelan kode fitur kode-pemulihan penonton (lib/recovery-code.ts, tests/, docs/).
*recovery-codes*.txt
*kode-pemulihan*.txt
# Kredensial cloudflared named tunnel — siapa pun yang punya berkas ini bisa
# membajak tunnel video. Yang boleh di-commit hanya cloudflared-config.example.yml.
pc-backup-agent/config.yml
pc-backup-agent/*.json
pc-backup-agent/logs/
public/videos/
public/audio/
public/episodes/
public/*.mp4
public/*.mkv
public/*.avi
public/*.mov
public/*.webm
_dubbing/
*.mp4
*.mkv
*.mov
*.avi
*.webm


# === pola lintasAI ===
# Cegah kebocoran: rahasia kit, identitas per-staff, folder cadangan.
.git-identity-*
.staff-profile.md
*.backup-*
*.bak
*.bak.*
.kimi-code/AGENTS.md
.lintasai/.audit-log
.lintasai/.manifest-secret
.lintasai/.install-manifest.json
.lintasai.backup-*/
.cursor/rules/lintasai.mdc

# Catatan pembelajaran lintasAI (berkas belajar, BUKAN berkas proyek — jangan ikut ter-commit)
docs/pelajaran-lintasai/

# Artefak dev server lokal — nomor proses, dibuat ulang tiap start.
*.pid
